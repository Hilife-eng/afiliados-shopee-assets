  "canva_instructions": {
    "step_1_create_template": [
      "Crie um design customizado: 1080x1920px (Stories/Reels)",
      "Adicione guias (View > Show margins > Custom): Top 150, Bottom 350, Left/Right 60",
      "Salve como 'Template Base - 9:16 Safe Zones'"
    ],
    "step_2_text_styles": [
      "Text > Text styles > Create new style para cada nível da escala tipográfica",
      "Nomes sugeridos: Display/Headline, H1, H2, H3, Body Large, Body, Caption, CTA Badge",
      "Configure: Font (Montserrat Alternates/Montserrat), Size, Weight, Line height, Letter spacing"
    ],
    "step_3_color_palette": [
      "Brand Kit > Colors > Add palette 'Cascata Natal'",
      "Adicione: #FF6B35 (Laranja), #2ED573 (Verde), #A55EEA (Roxo), #2E86DE (Azul), #FFD700 (Dourado)",
      "Adicione neutros: White 100%, 80%, 50%, 20% | Black 60%, 40%, 20%"
    ],
    "step_4_create_scenes": [
      "Duplique o template base 5x (uma por cena)",
      "Nomeie: Cena 01 - Gancho, Cena 02 - Problema, etc.",
      "Para cada cena: importe a imagem fonte, aplique o cinematic look (ajuste manual ou filtros)",
      "Adicione overlay gradiente (Element > Gradiente > Linear > Preto transparente → Preto 60%)",
      "Posicione textos conforme layout spec (use Text Styles criados)",
      "Crie componentes reutilizáveis: Badge Preço, Badge CTA"
    ],
    "step_5_bulk_create": [
      "Se tiver CSV (abaixo), use Apps > Bulk Create > Upload CSV",
      "Conecte campos: {{headline}}, {{subtext}}, {{specs}}, {{price}}, {{cta_text}}",
      "Gere todas de uma vez, depois ajuste fino manual"
    ],
    "step_6_export": [
      "Share > Download > MP4 Video (para Reels/TikTok/Shorts) - 25-30s total",
      "OU Download > PNG (para Stories sequenciais - 5 arquivos)",
      "Marque 'Include audio' se adicionou música no Canva"
    ]
  }
}